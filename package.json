{
  "name": "cashflow-expense-management",
  "version": "1.0.0",
  "description": "CashFlow - Full Stack Expense Management System Windows Application",
  "main": "electron-main.js",
  "scripts": {
    "install:setup": "Setup-CashFlow-Windows.bat",
    "install:all": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "start:backend": "npm start --prefix backend",
    "start:desktop": "electron .",
    "dist:win": "npm run build:frontend && electron-builder --win nsis",
    "uninstall:windows": "Uninstall-CashFlow-Windows.bat"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cashflow.expensemanagement",
    "productName": "CashFlow System",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron-main.js",
      "backend/**/*",
      "frontend/dist/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CashFlow System",
      "uninstallDisplayName": "CashFlow System Uninstaller"
    }
  }
}

